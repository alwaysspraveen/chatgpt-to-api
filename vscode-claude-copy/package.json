{
  "name": "drafts-panel",
  "displayName": "Drafts Panel for Claude Code",
  "description": "A side panel of the messages Claude Code drafts for you (Teams, Google Chat, Slack, email), with one-click copy that keeps bold and bullets. Unofficial; not affiliated with Anthropic.",
  "version": "0.6.1",
  "publisher": "alwaysspraveen",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#13343B",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "drafts",
    "teams",
    "google chat",
    "clipboard",
    "copy",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alwaysspraveen/chatgpt-to-api"
  },
  "bugs": {
    "url": "https://github.com/alwaysspraveen/chatgpt-to-api/issues"
  },
  "homepage": "https://github.com/alwaysspraveen/chatgpt-to-api/tree/main/vscode-claude-copy#readme",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:claudeCopy.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeCopy.copyLastDraft",
        "title": "Copy Last Draft",
        "category": "Drafts Panel"
      },
      {
        "command": "claudeCopy.pick",
        "title": "Pick a Draft to Copy…",
        "category": "Drafts Panel"
      },
      {
        "command": "claudeCopy.refresh",
        "title": "Refresh",
        "category": "Drafts Panel",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeCopy.clear",
        "title": "Delete All Drafts",
        "category": "Drafts Panel",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "claudeCopy.copyLastDraft",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": {
      "title": "Drafts Panel",
      "properties": {
        "claudeCopy.format": {
          "type": "string",
          "enum": [
            "rich",
            "plain",
            "markdown"
          ],
          "default": "rich",
          "enumDescriptions": [
            "Formatted (real bold, bullets): pastes cleanly into Teams, Outlook, Google Chat (macOS)",
            "No formatting at all",
            "Raw Markdown as written (shows ** in apps that don't render Markdown)"
          ],
          "description": "Format used by Copy, the shortcut and the status bar."
        },
        "claudeCopy.autoCopyDrafts": {
          "type": "boolean",
          "default": false,
          "description": "Copy each new draft to the clipboard as soon as Claude saves it."
        },
        "claudeCopy.draftsFile": {
          "type": "string",
          "default": "",
          "description": "Drafts file written by the save_draft MCP tool. Empty = ~/.claude-copy/drafts.jsonl."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCopy",
          "title": "Drafts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCopy": [
        {
          "type": "webview",
          "id": "claudeCopy.panel",
          "name": "Drafts"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeCopy.refresh",
          "when": "view == claudeCopy.panel",
          "group": "navigation@1"
        },
        {
          "command": "claudeCopy.clear",
          "when": "view == claudeCopy.panel",
          "group": "navigation@2"
        }
      ]
    }
  }
}
